{
  "compilerOptions": {
    "target": "es6",
    "module": "ESNext",
    "lib": ["es2017", "dom"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": false,
    "checkJs": false,
    "noEmitOnError": false
  },
  "include": [
    "frontend/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}