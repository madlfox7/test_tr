{
    "compilerOptions": {
      "target": "es6",
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      "allowJs": false,
      "checkJs": false,
      "noEmitOnError": false,
      "incremental": true,
"tsBuildInfoFile": ".tsbuildinfo"
    },
    "include": [
      "**/*"
    ],
    "exclude": [
      "node_modules"
    ]
  }